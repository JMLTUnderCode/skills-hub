{
    "name": "skills-hub",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "build:manifest": "node scripts/build-manifest.mjs",
        "sync:upstream": "node scripts/sync-upstream-skills.mjs",
        "sync:upstream:dry": "node scripts/sync-upstream-skills.mjs --dry-run --json",
        "check": "biome check .",
        "check:fix": "biome check --write .",
        "test": "node --test --experimental-test-module-mocks tests"
    },
    "engines": {
        "node": ">=18"
    },
    "packageManager": "pnpm@10.0.0",
    "devDependencies": {
        "@biomejs/biome": "^2.6.9"
    }
}
